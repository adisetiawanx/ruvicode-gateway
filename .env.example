# Server
PORT=8080
ENV=development

# Database (shared with frontend, same PostgreSQL instance)
DATABASE_URL=postgresql://ruvicode:CHANGE_ME@localhost:5432/ruvicode

# Redis
REDIS_URL=redis://localhost:6379

# Providers (comma-separated list of active provider names)
ACTIVE_PROVIDERS=provider

# Provider connection (generic naming, upstream identity masked)
PROVIDER_BASE_URL=
PROVIDER_API_KEYS=

# Pricing engine
PRICING_CRON_INTERVAL=2m
PRICING_SPREAD_PP=20

# Rate limiting
GLOBAL_RPM=60

# Logging
LOG_LEVEL=info
