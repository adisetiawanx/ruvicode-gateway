FROM golang:1.26-alpine AS builder

WORKDIR /app
COPY go.mod go.sum ./
RUN go mod download

COPY . .

# Build the USDC deposit monitor binary.
RUN CGO_ENABLED=0 GOOS=linux go build -o /monitor cmd/monitor/main.go

FROM alpine:3.20

RUN addgroup -S appgroup && adduser -S appuser -G appgroup
COPY --from=builder /monitor /monitor
USER appuser

CMD ["/monitor"]
